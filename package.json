{
  "name": "glint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:icons && eslint src",
    "lint:fix": "eslint src --fix",
    "postinstall": "prisma generate",
    "prepare": "husky || true",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --compiler-options '{\"module\": \"CommonJS\"}' prisma/seeds/main.ts",
    "generate-data": "ts-node scripts/generate-data.ts",
    "generate-data:remote": "GLINT_API_URL=https://your-app.vercel.app/api/trackAnalytics ts-node scripts/generate-data.ts",
    "generate-historical": "ts-node scripts/generate-historical-data.ts",
    "generate-historical:30": "ts-node scripts/generate-historical-data.ts 30",
    "backfill": "ts-node scripts/backfill-data.ts",
    "backfill:remote": "GLINT_API_URL=https://glint-dun.vercel.app/api/trackAnalytics ts-node scripts/backfill-data.ts",
    "kill-wrangler": "cd cloudflare-worker && ./kill-wrangler.sh",
    "deploy-worker": "cd cloudflare-worker && ./deploy.sh",
    "lint:icons": "node scripts/lint-icons.mjs",
    "test": "node --test tests/*.test.ts scripts/icons.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "d3": "^7.9.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^2.15.1",
    "lucide-react": "1.67.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "postcss": "^8.5.33",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "eslint --max-warnings 0"
    ],
    "*.{json,css,scss,md}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "postcss": "$postcss",
    "brace-expansion@1": "^1.1.22",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0"
  }
}
